  "nativeMethods": [
    "http.fetch",
    "oauth.authorize",
    "oauth.status",
    "oauth.disconnect",
    "storage.*",
    "image.fetch",
    "clipboard.write",
    "shell.openUrl",
    "hud.show",
    "toast.show",
    "alert.confirm",
    "media.control"
  ],
  "httpHosts": [
    "api.spotify.com",
    "lrclib.net",
    ".scdn.co",
    ".spotifycdn.com"
  ],
  "oauth": [
    "spotify"
  ],
  "uriSchemes": [
    "spotify"
  ],
  "preferences": [
    {
      "name": "clientId",
      "type": "text",
      "title": "Spotify Client ID",
      "description": "Client ID of your own Spotify app (developer.spotify.com/dashboard). Register http://127.0.0.1/callback as its Redirect URI. Leave empty to use FLOWKEY_SPOTIFY_CLIENT_ID or spotify-auth.json.",
      "required": false,
      "placeholder": "32-character client ID"
    },
    {
      "name": "closeWindowOnAction",
      "type": "checkbox",
      "title": "Close Window",
      "label": "Close window on action",
      "description": "If enabled, the launcher closes after performing an action",
      "default": false,
      "required": false
    },
    {
      "name": "musicOnly",
      "type": "checkbox",
      "title": "Search Filters",
      "label": "Music Only",
      "default": false,
      "required": false
    },
    {
      "name": "topView",
      "type": "dropdown",
      "title": "Search Top View",
      "default": "artists",
      "required": false,
      "options": [
        {
          "title": "Playlists",
          "value": "playlists"
        },
        {
          "title": "Albums",
          "value": "albums"
        },
        {
          "title": "Artists",
          "value": "artists"
        },
        {
          "title": "Songs",
          "value": "tracks"
        },
        {
          "title": "Podcasts & Shows",
          "value": "shows"
        },
        {
          "title": "Episodes",
          "value": "episodes"
        }
      ]
    },
    {
      "name": "libraryDefaultView",
      "type": "dropdown",
      "title": "Library Default View",
      "default": "all",
      "required": false,
      "options": [
        {
          "title": "All",
          "value": "all"
        },
        {
          "title": "Playlists",
          "value": "playlists"
        },
        {
          "title": "Albums",
          "value": "albums"
        },
        {
          "title": "Artists",
          "value": "artists"
        },
        {
          "title": "Songs",
          "value": "tracks"
        },
        {
          "title": "Podcasts & Shows",
          "value": "shows"
        },
        {
          "title": "Episodes",
          "value": "episodes"
        }
      ]
    }
  ]
