{
  "id": "spotify-player",
  "name": "Spotify Player",
  "version": "1.0.0",
  "description": "Search Spotify, browse your library and control playback, with the commands of Raycast's Spotify Player.",
  "icon": "🎧",
  "commands": [
    {
      "id": "search",
      "title": "Search",
      "subtitle": "Spotify",
      "mode": "view",
      "icon": "search",
      "iconColor": "#1DB954",
      "keywords": [
        "spotify",
        "music",
        "song",
        "artist",
        "album",
        "playlist",
        "podcast"
      ]
    },
    {
