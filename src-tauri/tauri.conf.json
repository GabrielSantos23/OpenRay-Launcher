        "width": 265,
        "height": 40,
        "focus": false,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "create": false,
        "backgroundColor": "#1f1f1f"
