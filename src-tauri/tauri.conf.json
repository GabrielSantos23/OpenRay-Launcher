    "security": {
      "csp": "default-src 'self'; script-src 'self' http://flowkey.localhost; worker-src 'self' blob:; frame-src http://flowkey.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: http://appicon.localhost http://clipimg.localhost http://extimg.localhost http://flowkey.localhost https:; connect-src 'self' ipc: http://ipc.localhost https://open.er-api.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../extensions/spotify-player/dist/": "extensions/spotify-player/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxM0VDMUM5NzczOEQyNjYKUldSbTBqaDN5Y0Urd2FHMmcxdGpRVUZBVTZtckhJc21VS1RaOGEyRlFkNkVKN1NVbkFwSExMa28K",
      "endpoints": [
        "https://github.com/GabrielSantos23/OpenRay-Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
