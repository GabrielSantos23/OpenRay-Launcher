{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openray",
  "version": "0.1.0",
  "identifier": "dev.openray.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Openray",
        "width": 750,
        "height": 475,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "center": true,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "hud",
        "title": "Openray HUD",
        "width": 232,
        "height": 46,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "settings",
        "title": "Openray Settings",
        "width": 1370,
        "height": 836,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "notes",
        "title": "Notes",
        "width": 440,
        "height": 762,
        "minWidth": 300,
        "minHeight": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "tooltip",
        "title": "Openray Tooltip",
        "width": 120,
        "height": 30,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundColor": "#1f1f1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: http://appicon.localhost http://clipimg.localhost https://www.google.com https://*.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://open.er-api.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
