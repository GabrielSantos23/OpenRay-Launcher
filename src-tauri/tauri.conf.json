        "width": 440,
        "height": 762,
        "minWidth": 300,
        "minHeight": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "backgroundColor": "#1f1f1f",
        "create": false
      },
      {
        "label": "tooltip",
