{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openray",
  "version": "0.1.21",
  "identifier": "dev.openray.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --process-per-site",
        "title": "Openray",
        "width": 750,
        "height": 475,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "center": true,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "hud",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --process-per-site",
        "title": "Openray HUD",
        "width": 232,
        "height": 46,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundColor": "#1f1f1f"
      },
      {
        "label": "settings",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --process-per-site",
        "title": "Openray Settings",
        "width": 1370,
        "height": 836,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#1f1f1f",
        "create": false
      },
      {
        "label": "notes",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --process-per-site",
